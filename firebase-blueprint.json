{
  "entities": {
    "UserProfile": {
      "description": "Authenticated user profile and Ayra preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoUrl": { "type": "string" },
        "preferredPersona": { "type": "string" },
        "preferredModelTier": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "email", "photoUrl", "preferredPersona", "preferredModelTier", "createdAt", "updatedAt"]
    },
    "CloudChatMessage": {
      "description": "Cloud-synced AI conversation message (ciphertext when E2EE is enabled, with chunked subcollection pointer when exceeding inline limit)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "localMessageId": { "type": "integer" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "modelUsed": { "type": "string" },
        "craftType": { "type": "string" },
        "craftPayload": { "type": "string" },
        "e2ee": { "type": "boolean" },
        "chunkCount": { "type": "integer" },
        "contentSha256": { "type": "string" },
        "timestampMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "localMessageId", "role", "content", "modelUsed", "craftType", "craftPayload", "timestampMs", "createdAt", "updatedAt"]
    },
    "PayloadChunk": {
      "description": "Authenticated SHA-256 verified ordered ciphertext payload chunk under messages or backups",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fieldName": { "type": "string" },
        "chunkIndex": { "type": "integer" },
        "totalChunks": { "type": "integer" },
        "data": { "type": "string" },
        "chunkSha256": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fieldName", "chunkIndex", "totalChunks", "data", "chunkSha256", "createdAt", "updatedAt"]
    },
    "CloudGitHubPlugin": {
      "description": "Cloud-synced installed GitHub plugin, Claude skill pack, OpenAPI tool, or MCP integration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "repoFullName": { "type": "string" },
        "repoUrl": { "type": "string" },
        "name": { "type": "string" },
        "owner": { "type": "string" },
        "description": { "type": "string" },
        "defaultBranch": { "type": "string" },
        "stars": { "type": "integer" },
        "primaryLanguage": { "type": "string" },
        "pluginType": { "type": "string" },
        "capabilitiesSummary": { "type": "string" },
        "skillPromptContext": { "type": "string" },
        "openApiSpecJson": { "type": "string" },
        "commandsJson": { "type": "string" },
        "fileTreeJson": { "type": "string" },
        "isEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "repoFullName", "repoUrl", "name", "owner", "description",
        "defaultBranch", "stars", "primaryLanguage", "pluginType",
        "capabilitiesSummary", "skillPromptContext", "openApiSpecJson",
        "commandsJson", "fileTreeJson", "isEnabled", "createdAt", "updatedAt"
      ]
    },
    "CloudCreation": {
      "description": "Cloud-synced AI creative studio artifact metadata (images, songs, videos, 3D models, PDFs)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "creationType": { "type": "string" },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "summary": { "type": "string" },
        "modelUsed": { "type": "string" },
        "e2ee": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "creationType", "title", "prompt", "summary", "modelUsed", "createdAt", "updatedAt"]
    },
    "TrustedDevice": {
      "description": "Registered E2EE trusted device public key bundle and revocation status",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "identityPublicKeyB64": { "type": "string" },
        "ecdhPublicKeyB64": { "type": "string" },
        "fingerprintSha256": { "type": "string" },
        "epochAdded": { "type": "integer" },
        "isRevoked": { "type": "boolean" },
        "platform": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "deviceId", "deviceName", "identityPublicKeyB64", "ecdhPublicKeyB64", "fingerprintSha256", "epochAdded", "isRevoked", "platform", "createdAt", "updatedAt"]
    },
    "CloudSession": {
      "description": "Active or revoked user device session record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "sessionId": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "status": { "type": "string" },
        "createdAtMs": { "type": "integer" },
        "lastActiveMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "sessionId", "deviceId", "deviceName", "status", "createdAtMs", "lastActiveMs", "createdAt", "updatedAt"]
    },
    "EncryptedCloudBackup": {
      "description": "Passphrase-encrypted Argon2/PBKDF2 + AES-GCM zero-knowledge vault backup (supports ordered chunks)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "backupId": { "type": "string" },
        "format": { "type": "string" },
        "encryptedPayloadJson": { "type": "string" },
        "payloadSha256": { "type": "string" },
        "chunkCount": { "type": "integer" },
        "createdAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "backupId", "format", "encryptedPayloadJson", "payloadSha256", "createdAtMs", "createdAt", "updatedAt"]
    },
    "SecurityEvent": {
      "description": "Append-only HMAC-chained security audit event synced for owner forensics",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "message": { "type": "string" },
        "hmacHex": { "type": "string" },
        "timestampMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "category", "severity", "message", "hmacHex", "timestampMs", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Per-user profile and preference settings"
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/CloudChatMessage" },
      "description": "Per-user synced chat history"
    },
    "/users/{userId}/messages/{messageId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/PayloadChunk" },
      "description": "Ordered authenticated payload chunks for oversized encrypted messages"
    },
    "/users/{userId}/plugins/{pluginId}": {
      "schema": { "$ref": "#/entities/CloudGitHubPlugin" },
      "description": "Per-user synced installed GitHub repository plugins and skills"
    },
    "/users/{userId}/creations/{creationId}": {
      "schema": { "$ref": "#/entities/CloudCreation" },
      "description": "Per-user synced AI creations log"
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/TrustedDevice" },
      "description": "Per-user E2EE registered devices and revocation state"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/CloudSession" },
      "description": "Per-user device session registry"
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": { "$ref": "#/entities/EncryptedCloudBackup" },
      "description": "Per-user encrypted backup snapshots"
    },
    "/users/{userId}/backups/{backupId}/chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/PayloadChunk" },
      "description": "Ordered authenticated payload chunks for oversized encrypted backups"
    },
    "/users/{userId}/securityEvents/{eventId}": {
      "schema": { "$ref": "#/entities/SecurityEvent" },
      "description": "Per-user HMAC-signed security audit log events"
    }
  }
}
