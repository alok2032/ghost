# Copy this file to keystore.properties (gitignored) for local Play Store upload signing.
# NEVER commit real passwords or .jks/.keystore files to version control.
#
# 1. Generate a new Play Store upload keystore:
#    keytool -genkeypair -v -keystore upload-keystore.jks -alias ayra_ai_upload \
#      -keyalg RSA -keysize 4096 -validity 10000
#
# 2. Extract your SHA-1 / SHA-256 fingerprints and register BOTH in Firebase Console
#    (Project settings -> Your apps -> com.ayra.ai.app -> Add fingerprint), then
#    download a refreshed app/google-services.json before shipping to Google Play:
#    keytool -list -v -keystore upload-keystore.jks -alias ayra_ai_upload
#
# 3. For production release builds outside this AI Studio container, configure
#    app/build.gradle.kts release signingConfig to read storeFile, storePassword,
#    keyAlias, and keyPassword from keystore.properties or CI environment variables
#    instead of debug.keystore.

storeFile=/absolute/path/to/upload-keystore.jks
storePassword=REPLACE_WITH_STRONG_STORE_PASSWORD
keyAlias=ayra_ai_upload
keyPassword=REPLACE_WITH_STRONG_KEY_PASSWORD
