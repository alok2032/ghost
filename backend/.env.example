# AYRA Zero-Trust Backend Configuration (NEVER commit real secrets)
PORT=8443
NODE_ENV=production
FIREBASE_PROJECT_ID=gen-lang-client-0595455617
# Require Firebase App Check tokens on protected routes in production
REQUIRE_APP_CHECK=true
# Comma-separated exact origins allowed for CORS (empty disables cross-origin browser requests)
CORS_ALLOWED_ORIGINS=https://ayra.ai.app
# Rate limit window (ms) and max requests per authenticated user/IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Per-user quota for /api/v1/code/run within RATE_LIMIT_WINDOW_MS
CODE_SANDBOX_MAX_PER_WINDOW=10
# Remote isolated sandbox runner (HTTPS endpoint + bearer token; /api/v1/code/run fails closed with 503 if unset)
SANDBOX_EXECUTOR_URL=
SANDBOX_EXECUTOR_TOKEN=
# External AI provider API keys (inject via cloud Secret Manager / environment only)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
