rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Global Fail-Closed Safety Net (must remain the first match block)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Hardened Global Predicates & Sanitizers
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.uid.size() > 0
        && (!('firebase' in request.auth.token) || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id != '.'
        && id != '..'
        && id.matches('^[a-zA-Z0-9._\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && isValidId(userId);
    }

    function hasValidCreateTimestamps(data) {
      return data.createdAt is timestamp
        && data.createdAt <= request.time
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    function hasValidUpdateTimestamps(data) {
      return data.createdAt == existing().createdAt
        && data.updatedAt is timestamp
        && data.updatedAt <= request.time;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap & Anti-Injection)
    // -------------------------------------------------------------------------
    function isValidUserProfile(userId, data) {
      return data.keys().hasAll([
          'userId', 'displayName', 'email', 'photoUrl',
          'preferredPersona', 'preferredModelTier', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'displayName', 'email', 'photoUrl',
          'preferredPersona', 'preferredModelTier', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.displayName is string && data.displayName.size() <= 120
        && data.email is string && data.email.size() <= 200
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && data.preferredPersona is string && data.preferredPersona.size() <= 40
        && data.preferredModelTier is string && data.preferredModelTier.size() <= 60;
    }

    function isValidCloudMessage(userId, data) {
      return data.keys().hasAll([
          'userId', 'localMessageId', 'role', 'content',
          'modelUsed', 'craftType', 'craftPayload', 'timestampMs',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'localMessageId', 'role', 'content',
          'modelUsed', 'craftType', 'craftPayload', 'e2ee',
          'chunkCount', 'contentSha256', 'timestampMs',
          'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.localMessageId is int && data.localMessageId >= 0
        && data.role in ['user', 'assistant']
        && data.content is string && data.content.size() <= 100000
        && data.modelUsed is string && data.modelUsed.size() <= 120
        && data.craftType is string && data.craftType.size() <= 40
        && data.craftPayload is string && data.craftPayload.size() <= 100000
        && (!('e2ee' in data) || data.e2ee is bool)
        && (!('chunkCount' in data) || (data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 50))
        && (!('contentSha256' in data) || (data.contentSha256 is string && data.contentSha256.matches('^[0-9a-fA-F]{64}$')))
        && data.timestampMs is int && data.timestampMs >= 0;
    }

    function isValidPayloadChunk(userId, data) {
      return data.keys().hasAll([
          'userId', 'fieldName', 'chunkIndex', 'totalChunks',
          'data', 'chunkSha256', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'fieldName', 'chunkIndex', 'totalChunks',
          'data', 'chunkSha256', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.fieldName in ['content', 'craftPayload', 'encryptedPayloadJson']
        && data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex < 50
        && data.totalChunks is int && data.totalChunks >= 1 && data.totalChunks <= 50
        && data.chunkIndex < data.totalChunks
        && data.data is string && data.data.size() >= 1 && data.data.size() <= 90000
        && data.chunkSha256 is string && data.chunkSha256.matches('^[0-9a-fA-F]{64}$');
    }

    function isValidCloudPlugin(userId, data) {
      return data.keys().hasAll([
          'userId', 'repoFullName', 'repoUrl', 'name', 'owner', 'description',
          'defaultBranch', 'stars', 'primaryLanguage', 'pluginType',
          'capabilitiesSummary', 'skillPromptContext', 'openApiSpecJson',
          'commandsJson', 'fileTreeJson', 'isEnabled', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'repoFullName', 'repoUrl', 'name', 'owner', 'description',
          'defaultBranch', 'stars', 'primaryLanguage', 'pluginType',
          'capabilitiesSummary', 'skillPromptContext', 'openApiSpecJson',
          'commandsJson', 'fileTreeJson', 'isEnabled', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.repoFullName is string && data.repoFullName.size() >= 1 && data.repoFullName.size() <= 140
        && data.repoUrl is string && data.repoUrl.size() >= 8 && data.repoUrl.size() <= 300 && data.repoUrl.matches('^https://.*')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.owner is string && data.owner.size() >= 1 && data.owner.size() <= 100
        && data.description is string && data.description.size() <= 1000
        && data.defaultBranch is string && data.defaultBranch.size() >= 1 && data.defaultBranch.size() <= 80
        && data.stars is int && data.stars >= 0
        && data.primaryLanguage is string && data.primaryLanguage.size() <= 60
        && data.pluginType in ['SKILL_PACK', 'OPENAPI_PLUGIN', 'MCP_SERVER', 'WEB_TOOL', 'CODE_PLUGIN']
        && data.capabilitiesSummary is string && data.capabilitiesSummary.size() <= 4000
        && data.skillPromptContext is string && data.skillPromptContext.size() <= 20000
        && data.openApiSpecJson is string && data.openApiSpecJson.size() <= 20000
        && data.commandsJson is string && data.commandsJson.size() <= 10000
        && data.fileTreeJson is string && data.fileTreeJson.size() <= 15000
        && data.isEnabled is bool;
    }

    function isValidCloudCreation(userId, data) {
      return data.keys().hasAll([
          'userId', 'creationType', 'title', 'prompt',
          'summary', 'modelUsed', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'creationType', 'title', 'prompt',
          'summary', 'modelUsed', 'e2ee', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.creationType in ['IMAGE', 'VIDEO', 'SONG', '3D', 'PDF']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 20000
        && data.summary is string && data.summary.size() <= 50000
        && data.modelUsed is string && data.modelUsed.size() <= 120
        && (!('e2ee' in data) || data.e2ee is bool);
    }

    function isValidTrustedDevice(userId, deviceId, data) {
      return data.keys().hasAll([
          'userId', 'deviceId', 'deviceName', 'identityPublicKeyB64',
          'ecdhPublicKeyB64', 'fingerprintSha256', 'epochAdded', 'isRevoked',
          'platform', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'deviceId', 'deviceName', 'identityPublicKeyB64',
          'ecdhPublicKeyB64', 'fingerprintSha256', 'epochAdded', 'isRevoked',
          'platform', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.deviceId == deviceId
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 120
        && data.identityPublicKeyB64 is string && data.identityPublicKeyB64.size() >= 16 && data.identityPublicKeyB64.size() <= 1024
        && data.ecdhPublicKeyB64 is string && data.ecdhPublicKeyB64.size() >= 16 && data.ecdhPublicKeyB64.size() <= 1024
        && data.fingerprintSha256 is string && data.fingerprintSha256.size() >= 16 && data.fingerprintSha256.size() <= 128
        && data.epochAdded is int && data.epochAdded >= 1
        && data.isRevoked is bool
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 64;
    }

    function isValidCloudSession(userId, sessionId, data) {
      return data.keys().hasAll([
          'userId', 'sessionId', 'deviceId', 'deviceName',
          'status', 'createdAtMs', 'lastActiveMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'sessionId', 'deviceId', 'deviceName',
          'status', 'createdAtMs', 'lastActiveMs', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.sessionId == sessionId
        && data.deviceId is string && data.deviceId.size() >= 1 && data.deviceId.size() <= 128
        && data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 120
        && data.status in ['ACTIVE', 'REVOKED', 'EXPIRED']
        && data.createdAtMs is int && data.createdAtMs >= 0
        && data.lastActiveMs is int && data.lastActiveMs >= data.createdAtMs;
    }

    function isValidCloudBackup(userId, backupId, data) {
      return data.keys().hasAll([
          'userId', 'backupId', 'format', 'encryptedPayloadJson',
          'payloadSha256', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'backupId', 'format', 'encryptedPayloadJson',
          'payloadSha256', 'chunkCount', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.backupId == backupId
        && data.format is string && data.format.size() >= 1 && data.format.size() <= 60
        && data.encryptedPayloadJson is string && data.encryptedPayloadJson.size() >= 16 && data.encryptedPayloadJson.size() <= 800000
        && data.payloadSha256 is string && data.payloadSha256.matches('^[0-9a-fA-F]{64}$')
        && (!('chunkCount' in data) || (data.chunkCount is int && data.chunkCount >= 0 && data.chunkCount <= 50))
        && data.createdAtMs is int && data.createdAtMs >= 0;
    }

    function isValidSecurityEvent(userId, data) {
      return data.keys().hasAll([
          'userId', 'category', 'severity', 'message',
          'hmacHex', 'timestampMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'category', 'severity', 'message',
          'hmacHex', 'timestampMs', 'createdAt', 'updatedAt'
        ])
        && data.userId == userId
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
        && data.severity in ['INFO', 'WARN', 'CRITICAL']
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 500
        && data.hmacHex is string && data.hmacHex.size() >= 16 && data.hmacHex.size() <= 128 && data.hmacHex.matches('^[a-zA-Z0-9_]+$')
        && data.timestampMs is int && data.timestampMs >= 0;
    }

    // -------------------------------------------------------------------------
    // Shared System & Administrative Resources (Strictly Restricted: Server/Admin SDK Only)
    // Client SDKs have zero read or write access to shared infrastructure state.
    // -------------------------------------------------------------------------
    match /admins/{adminPath=**} {
      allow read, write: if false;
    }

    match /system/{systemPath=**} {
      allow read, write: if false;
    }

    match /config/{configPath=**} {
      allow read, write: if false;
    }

    match /shared/{sharedPath=**} {
      allow read, write: if false;
    }

    match /auditLogs/{auditPath=**} {
      allow read, write: if false;
    }

    match /modelCatalog/{catalogPath=**} {
      allow read, write: if false;
    }

    match /workspaces/{workspacePath=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Owner-Only User Documents & Subcollections
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Owner may read only their own profile document; root listing is strictly forbidden.
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidUserProfile(userId, incoming())
        && hasValidCreateTimestamps(incoming());
      allow update: if isOwner(userId)
        && isValidUserProfile(userId, incoming())
        && hasValidUpdateTimestamps(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'photoUrl',
          'preferredPersona', 'preferredModelTier', 'updatedAt'
        ]);
      allow delete: if isOwner(userId);

      // Fail-closed default for any unmodeled subcollection beneath /users/{userId}
      match /{unknownSub=**} {
        allow read, write: if false;
      }

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(messageId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(messageId)
          && isValidCloudMessage(userId, incoming())
          && hasValidCreateTimestamps(incoming());
        allow update: if isOwner(userId)
          && isValidId(messageId)
          && isValidCloudMessage(userId, incoming())
          && hasValidUpdateTimestamps(incoming())
          && incoming().userId == existing().userId
          && incoming().localMessageId == existing().localMessageId
          && incoming().role == existing().role
          && incoming().timestampMs == existing().timestampMs
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'content', 'modelUsed', 'craftType', 'craftPayload', 'e2ee',
            'chunkCount', 'contentSha256', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(messageId);

        match /chunks/{chunkId} {
          allow get, list: if isOwner(userId) && isValidId(messageId);
          allow create: if isOwner(userId)
            && isValidId(messageId)
            && isValidId(chunkId)
            && isValidPayloadChunk(userId, incoming())
            && hasValidCreateTimestamps(incoming());
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(messageId) && isValidId(chunkId);
        }
      }

      match /plugins/{pluginId} {
        allow get: if isOwner(userId) && isValidId(pluginId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(pluginId)
          && isValidCloudPlugin(userId, incoming())
          && hasValidCreateTimestamps(incoming());
        allow update: if isOwner(userId)
          && isValidId(pluginId)
          && isValidCloudPlugin(userId, incoming())
          && hasValidUpdateTimestamps(incoming())
          && incoming().userId == existing().userId
          && incoming().repoFullName == existing().repoFullName
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'repoUrl', 'name', 'owner', 'description', 'defaultBranch',
            'stars', 'primaryLanguage', 'pluginType', 'capabilitiesSummary',
            'skillPromptContext', 'openApiSpecJson', 'commandsJson',
            'fileTreeJson', 'isEnabled', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(pluginId);
      }

      match /creations/{creationId} {
        allow get: if isOwner(userId) && isValidId(creationId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(creationId)
          && isValidCloudCreation(userId, incoming())
          && hasValidCreateTimestamps(incoming());
        allow update: if isOwner(userId)
          && isValidId(creationId)
          && isValidCloudCreation(userId, incoming())
          && hasValidUpdateTimestamps(incoming())
          && incoming().userId == existing().userId
          && incoming().creationType == existing().creationType
          && incoming().prompt == existing().prompt
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'summary', 'modelUsed', 'e2ee', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(creationId);
      }

      match /devices/{deviceId} {
        allow get: if isOwner(userId) && isValidId(deviceId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(deviceId)
          && isValidTrustedDevice(userId, deviceId, incoming())
          && hasValidCreateTimestamps(incoming());
        allow update: if isOwner(userId)
          && isValidId(deviceId)
          && isValidTrustedDevice(userId, deviceId, incoming())
          && hasValidUpdateTimestamps(incoming())
          && incoming().userId == existing().userId
          && incoming().deviceId == existing().deviceId
          && incoming().platform == existing().platform
          && incoming().epochAdded >= existing().epochAdded
          && (!existing().isRevoked || incoming().isRevoked == true)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'deviceName', 'identityPublicKeyB64', 'ecdhPublicKeyB64',
            'fingerprintSha256', 'epochAdded', 'isRevoked', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(deviceId);
      }

      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(sessionId)
          && isValidCloudSession(userId, sessionId, incoming())
          && hasValidCreateTimestamps(incoming());
        allow update: if isOwner(userId)
          && isValidId(sessionId)
          && isValidCloudSession(userId, sessionId, incoming())
          && hasValidUpdateTimestamps(incoming())
          && incoming().userId == existing().userId
          && incoming().sessionId == existing().sessionId
          && incoming().deviceId == existing().deviceId
          && incoming().createdAtMs == existing().createdAtMs
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'deviceName', 'status', 'lastActiveMs', 'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /backups/{backupId} {
        allow get: if isOwner(userId) && isValidId(backupId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(backupId)
          && isValidCloudBackup(userId, backupId, incoming())
          && hasValidCreateTimestamps(incoming());
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(backupId);

        match /chunks/{chunkId} {
          allow get, list: if isOwner(userId) && isValidId(backupId);
          allow create: if isOwner(userId)
            && isValidId(backupId)
            && isValidId(chunkId)
            && isValidPayloadChunk(userId, incoming())
            && hasValidCreateTimestamps(incoming());
          allow update: if false;
          allow delete: if isOwner(userId) && isValidId(backupId) && isValidId(chunkId);
        }
      }

      match /securityEvents/{eventId} {
        allow get: if isOwner(userId) && isValidId(eventId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(eventId)
          && isValidSecurityEvent(userId, incoming())
          && hasValidCreateTimestamps(incoming());
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(eventId);
      }
    }
  }
}
