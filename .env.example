# AYRA AI Environment Configuration Template
# Never commit real API keys, tokens, or .env files.

NODE_ENV=development
PORT=8443

# Single source of truth Firebase project ID (must match app/google-services.json)
FIREBASE_PROJECT_ID=
REQUIRE_APP_CHECK=true

# Comma-separated strict CORS allowlist (never *)
CORS_ALLOWED_ORIGINS=

# Distributed Redis REST rate limiting (required in production unless ALLOW_IN_MEMORY_RATE_LIMIT=true)
REDIS_REST_URL=
REDIS_REST_TOKEN=
ALLOW_IN_MEMORY_RATE_LIMIT=false

# Rate limits & multi-tier quotas
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
AI_PROVIDER_RATE_LIMIT_MAX=120
AI_MODEL_RATE_LIMIT_MAX=60
TOOL_RATE_LIMIT_MAX=20
GLOBAL_RATE_LIMIT_MAX=1000
MAX_CONCURRENT_REQUESTS_PER_USER=4
DAILY_TOKEN_QUOTA_PER_USER=250000
DAILY_SPEND_CAP_USD_PER_USER=5.00
CODE_SANDBOX_MAX_PER_WINDOW=10

# Remote isolated code sandbox (fail closed if unset or attestation missing)
SANDBOX_EXECUTOR_URL=
SANDBOX_EXECUTOR_TOKEN=
SANDBOX_ATTESTATION_SECRET=
SANDBOX_ALLOWED_HOSTS=

# Server-side AI provider keys (never shipped inside Android APK)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=