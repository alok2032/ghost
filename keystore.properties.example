# Production Release Upload Keystore Configuration Template (NEVER commit keystore.properties or *.jks)
# Generate an upload keystore using:
#   keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 4096 -validity 10000 -alias ayra-upload
# Store passwords in your password manager / CI secrets (AYRA_UPLOAD_KEYSTORE_B64, AYRA_UPLOAD_KEYSTORE_PASSWORD, AYRA_UPLOAD_KEY_ALIAS, AYRA_UPLOAD_KEY_PASSWORD).

storeFile=/secure/path/to/upload-keystore.jks
storePassword=
keyAlias=ayra-upload
keyPassword=
