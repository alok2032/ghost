# Copy this file to keystore.properties (gitignored) for local Play Store upload signing.
# NEVER commit real passwords or .jks/.keystore files to version control.
#
# Generate a new Play Store upload keystore with:
#   keytool -genkeypair -v -keystore upload-keystore.jks -alias ayra_upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=REPLACE_WITH_STRONG_STORE_PASSWORD
keyAlias=ayra_upload
keyPassword=REPLACE_WITH_STRONG_KEY_PASSWORD
